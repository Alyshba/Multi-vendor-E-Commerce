      }
    },
    {
      "name": "Products - Reject",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/products/1/reject",
          "host": ["{{base_url}}"],
          "path": ["api", "products", "1", "reject"]
        }
      }
    }
  ]
